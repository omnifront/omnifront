{
	"name": "@unicore/react",
	"version": "0.0.0",
	"description": "React adapter for unicore: QueryProvider, useQuery, useMutation, useStore and HydrationBoundary.",
	"license": "MIT",
	"keywords": [
		"unicore",
		"react",
		"hooks"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AMHB-DEV/unicore.git",
		"directory": "packages/react"
	},
	"homepage": "https://github.com/AMHB-DEV/unicore/tree/main/packages/react#readme",
	"bugs": {
		"url": "https://github.com/AMHB-DEV/unicore/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./infinite": {
			"types": "./dist/infinite.d.ts",
			"import": "./dist/infinite.js",
			"require": "./dist/infinite.cjs"
		},
		"./suspense": {
			"types": "./dist/suspense.d.ts",
			"import": "./dist/suspense.js",
			"require": "./dist/suspense.cjs"
		},
		"./queries": {
			"types": "./dist/queries.d.ts",
			"import": "./dist/queries.js",
			"require": "./dist/queries.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/infinite.ts src/queries.ts src/suspense.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/query": "workspace:*",
		"@unicore/core": "workspace:*",
		"@unicore/query-infinite": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@unicore/conformance": "workspace:*",
		"jsdom": "^31.0.0",
		"react": ">=18",
		"react-dom": "^19.3.1",
		"@unicore/store": "workspace:*"
	}
}
