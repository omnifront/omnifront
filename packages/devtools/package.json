{
	"name": "@omnifront/devtools",
	"version": "0.0.0",
	"description": "Inspect the omnifront query cache: a headless model plus a framework-free DOM panel.",
	"license": "MIT",
	"keywords": [
		"omnifront",
		"devtools",
		"query",
		"cache"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omnifront/omnifront.git",
		"directory": "packages/devtools"
	},
	"homepage": "https://github.com/omnifront/omnifront/tree/main/packages/devtools#readme",
	"bugs": {
		"url": "https://github.com/omnifront/omnifront/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./panel": {
			"import": {
				"types": "./dist/panel.d.ts",
				"default": "./dist/panel.js"
			},
			"require": {
				"types": "./dist/panel.d.cts",
				"default": "./dist/panel.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/panel.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@omnifront/core": "workspace:*",
		"@omnifront/query": "workspace:*"
	}
}
