{
	"name": "@unicore/angular",
	"version": "0.0.0",
	"description": "Angular adapter for unicore: provideUnicore and signal-based injectQuery, injectMutation and injectStore.",
	"license": "MIT",
	"keywords": [
		"unicore",
		"angular",
		"signals"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AMHB-DEV/unicore.git",
		"directory": "packages/angular"
	},
	"homepage": "https://github.com/AMHB-DEV/unicore/tree/main/packages/angular#readme",
	"bugs": {
		"url": "https://github.com/AMHB-DEV/unicore/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./infinite": {
			"types": "./dist/infinite.d.ts",
			"import": "./dist/infinite.js",
			"require": "./dist/infinite.cjs"
		},
		"./ssr": {
			"types": "./dist/ssr.d.ts",
			"import": "./dist/ssr.js",
			"require": "./dist/ssr.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/infinite.ts src/ssr.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/core": "workspace:*",
		"@unicore/query": "workspace:*",
		"@unicore/query-infinite": "workspace:*"
	},
	"peerDependencies": {
		"@angular/core": ">=17"
	},
	"devDependencies": {
		"@angular/common": "^22.2.5",
		"@angular/compiler": "^22.2.5",
		"@angular/core": ">=17",
		"@angular/platform-browser": "^22.2.5",
		"@angular/platform-server": "^22.2.5",
		"@unicore/conformance": "workspace:*",
		"@unicore/store": "workspace:*",
		"jsdom": "^31.0.0",
		"rxjs": "^7.8.2"
	}
}
