{
	"name": "@unicore/angular",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/query": "workspace:*",
		"@unicore/core": "workspace:*"
	},
	"peerDependencies": {
		"@angular/core": ">=17"
	},
	"devDependencies": {
		"@angular/common": "^22.2.5",
		"@angular/compiler": "^22.2.5",
		"@angular/core": ">=17",
		"@angular/platform-browser": "^22.2.5",
		"@unicore/conformance": "workspace:*",
		"jsdom": "^31.0.0",
		"rxjs": "^7.8.2",
		"@unicore/store": "workspace:*"
	}
}
