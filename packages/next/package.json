{
	"name": "@unicore/next",
	"version": "0.0.0",
	"description": "Next.js helpers for unicore: per-request query clients, dehydrate/hydrate and a client entry for the App Router and Pages Router.",
	"license": "MIT",
	"keywords": [
		"unicore",
		"nextjs",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AMHB-DEV/unicore.git",
		"directory": "packages/next"
	},
	"homepage": "https://github.com/AMHB-DEV/unicore/tree/main/packages/next#readme",
	"bugs": {
		"url": "https://github.com/AMHB-DEV/unicore/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"require": "./dist/client.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup --config tsup.server.config.ts && tsup --config tsup.client.config.ts",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/query": "workspace:*",
		"@unicore/react": "workspace:*"
	},
	"peerDependencies": {
		"next": ">=14",
		"react": ">=18"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@unicore/core": "workspace:*",
		"jsdom": "^31.0.0",
		"react": ">=18",
		"react-dom": "^19.3.1"
	}
}
