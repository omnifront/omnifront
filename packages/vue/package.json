{
	"name": "@omnifront/vue",
	"version": "0.0.0",
	"description": "Vue 3 adapter for omnifront: a plugin plus useQuery, useMutation and useStore composables.",
	"license": "MIT",
	"keywords": [
		"omnifront",
		"vue",
		"composables"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omnifront/omnifront.git",
		"directory": "packages/vue"
	},
	"homepage": "https://github.com/omnifront/omnifront/tree/main/packages/vue#readme",
	"bugs": {
		"url": "https://github.com/omnifront/omnifront/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./infinite": {
			"import": {
				"types": "./dist/infinite.d.ts",
				"default": "./dist/infinite.js"
			},
			"require": {
				"types": "./dist/infinite.d.cts",
				"default": "./dist/infinite.cjs"
			}
		},
		"./queries": {
			"import": {
				"types": "./dist/queries.d.ts",
				"default": "./dist/queries.js"
			},
			"require": {
				"types": "./dist/queries.d.cts",
				"default": "./dist/queries.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/infinite.ts src/queries.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@omnifront/query": "workspace:*",
		"@omnifront/core": "workspace:*",
		"@omnifront/query-infinite": "workspace:*"
	},
	"peerDependencies": {
		"vue": ">=3.3"
	},
	"devDependencies": {
		"@omnifront/conformance": "workspace:*",
		"jsdom": "^31.0.0",
		"vue": ">=3.3",
		"@omnifront/store": "workspace:*"
	}
}
