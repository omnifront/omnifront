{
	"name": "@unicore/vue",
	"version": "0.0.0",
	"description": "Vue 3 adapter for unicore: a plugin plus useQuery, useMutation and useStore composables.",
	"keywords": [
		"unicore",
		"vue",
		"composables"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AMHB-DEV/unicore.git",
		"directory": "packages/vue"
	},
	"homepage": "https://github.com/AMHB-DEV/unicore/tree/main/packages/vue#readme",
	"bugs": {
		"url": "https://github.com/AMHB-DEV/unicore/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/query": "workspace:*",
		"@unicore/core": "workspace:*"
	},
	"peerDependencies": {
		"vue": ">=3.3"
	},
	"devDependencies": {
		"@unicore/conformance": "workspace:*",
		"jsdom": "^31.0.0",
		"vue": ">=3.3",
		"@unicore/store": "workspace:*"
	}
}
