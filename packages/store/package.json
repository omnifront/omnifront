{
	"name": "@omnifront/store",
	"version": "0.0.0",
	"description": "A tiny framework-agnostic store with selectors, for use with omnifront adapters.",
	"license": "MIT",
	"keywords": [
		"omnifront",
		"store",
		"state"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omnifront/omnifront.git",
		"directory": "packages/store"
	},
	"homepage": "https://github.com/omnifront/omnifront/tree/main/packages/store#readme",
	"bugs": {
		"url": "https://github.com/omnifront/omnifront/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@omnifront/core": "workspace:*"
	}
}
