{
	"name": "@unicore/persist",
	"version": "0.0.0",
	"description": "Persist the unicore query cache to localStorage, IndexedDB or any storage, and restore it on startup.",
	"license": "MIT",
	"keywords": [
		"unicore",
		"persist",
		"cache",
		"offline"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AMHB-DEV/unicore.git",
		"directory": "packages/persist"
	},
	"homepage": "https://github.com/AMHB-DEV/unicore/tree/main/packages/persist#readme",
	"bugs": {
		"url": "https://github.com/AMHB-DEV/unicore/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./indexeddb": {
			"import": {
				"types": "./dist/indexeddb.d.ts",
				"default": "./dist/indexeddb.js"
			},
			"require": {
				"types": "./dist/indexeddb.d.cts",
				"default": "./dist/indexeddb.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/indexeddb.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/query": "workspace:*"
	},
	"devDependencies": {
		"@unicore/core": "workspace:*",
		"fake-indexeddb": "^6.2.7"
	}
}
