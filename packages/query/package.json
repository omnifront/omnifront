{
	"name": "@omnifront/query",
	"version": "0.0.0",
	"description": "Framework-agnostic query cache: fetching, deduplication, retries, invalidation, mutations and SSR hydration.",
	"license": "MIT",
	"keywords": [
		"omnifront",
		"query",
		"cache",
		"fetch",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omnifront/omnifront.git",
		"directory": "packages/query"
	},
	"homepage": "https://github.com/omnifront/omnifront/tree/main/packages/query#readme",
	"bugs": {
		"url": "https://github.com/omnifront/omnifront/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./hydration": {
			"import": {
				"types": "./dist/hydration.d.ts",
				"default": "./dist/hydration.js"
			},
			"require": {
				"types": "./dist/hydration.d.cts",
				"default": "./dist/hydration.cjs"
			}
		},
		"./structural": {
			"import": {
				"types": "./dist/structural.d.ts",
				"default": "./dist/structural.js"
			},
			"require": {
				"types": "./dist/structural.d.cts",
				"default": "./dist/structural.cjs"
			}
		},
		"./prefetch": {
			"import": {
				"types": "./dist/prefetch.d.ts",
				"default": "./dist/prefetch.js"
			},
			"require": {
				"types": "./dist/prefetch.d.cts",
				"default": "./dist/prefetch.cjs"
			}
		},
		"./filters": {
			"import": {
				"types": "./dist/filters.d.ts",
				"default": "./dist/filters.js"
			},
			"require": {
				"types": "./dist/filters.d.cts",
				"default": "./dist/filters.cjs"
			}
		},
		"./events": {
			"import": {
				"types": "./dist/events.d.ts",
				"default": "./dist/events.js"
			},
			"require": {
				"types": "./dist/events.d.cts",
				"default": "./dist/events.cjs"
			}
		},
		"./options": {
			"import": {
				"types": "./dist/options.d.ts",
				"default": "./dist/options.js"
			},
			"require": {
				"types": "./dist/options.d.cts",
				"default": "./dist/options.cjs"
			}
		},
		"./offline": {
			"import": {
				"types": "./dist/offline.d.ts",
				"default": "./dist/offline.js"
			},
			"require": {
				"types": "./dist/offline.d.cts",
				"default": "./dist/offline.cjs"
			}
		},
		"./activity": {
			"import": {
				"types": "./dist/activity.d.ts",
				"default": "./dist/activity.js"
			},
			"require": {
				"types": "./dist/activity.d.cts",
				"default": "./dist/activity.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/hydration.ts src/structural.ts src/prefetch.ts src/activity.ts src/filters.ts src/events.ts src/options.ts src/offline.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@omnifront/core": "workspace:*"
	}
}
