{
	"name": "@unicore/query",
	"version": "0.0.0",
	"description": "Framework-agnostic query cache: fetching, deduplication, retries, invalidation, mutations and SSR hydration.",
	"license": "MIT",
	"keywords": [
		"unicore",
		"query",
		"cache",
		"fetch",
		"ssr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AMHB-DEV/unicore.git",
		"directory": "packages/query"
	},
	"homepage": "https://github.com/AMHB-DEV/unicore/tree/main/packages/query#readme",
	"bugs": {
		"url": "https://github.com/AMHB-DEV/unicore/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./hydration": {
			"types": "./dist/hydration.d.ts",
			"import": "./dist/hydration.js",
			"require": "./dist/hydration.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/hydration.ts --format esm,cjs --dts --clean",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@unicore/core": "workspace:*"
	}
}
