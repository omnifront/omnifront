{
	"name": "@omnifront/e2e-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Real-browser checks for the UI kit: the same page in React, Vue and Angular must look the same, and pass axe including colour contrast.",
	"scripts": {
		"build:examples": "pnpm --filter \"@omnifront/example-ui-react...\" --filter \"@omnifront/example-ui-vue...\" --filter \"@omnifront/example-ui-angular...\" --workspace-concurrency=1 build",
		"e2e": "playwright test",
		"install-browsers": "playwright install chromium firefox webkit",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.0",
		"@playwright/test": "^1.60.0",
		"@types/node": "^24.0.0",
		"@types/pngjs": "^6.0.5",
		"pixelmatch": "^7.1.0",
		"pngjs": "^7.0.0",
		"vite": "^8.3.6"
	}
}
