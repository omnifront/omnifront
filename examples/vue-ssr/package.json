{
	"name": "@omnifront/example-vue-ssr",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node server.mjs",
		"build": "vue-tsc --noEmit && vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@omnifront/query": "workspace:*",
		"@omnifront/vue": "workspace:*"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.10",
		"typescript": "~5.9.3",
		"vite": "^8.3.6",
		"vue": ">=3.3",
		"vue-tsc": "^3.3.14"
	}
}
